{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "reviews",
	"name": "WB Reviews",
	"keywords": ["reviews", "ratings", "stars", "feedback", "schema"],
	"publisher": "did:plc:2o6axbe264shvyedyhycyhya",

	"license": "MIT",
	"repo": "https://github.com/wbcomdesigns/emdash-reviews",
	"author": { "name": "Wbcom Designs", "url": "https://wbcomdesigns.com", "email": "security@wbcomdesigns.com" },
	"security": { "email": "security@wbcomdesigns.com" },
	"description": "Star ratings and moderated reviews for articles and pages.",
	"sections": {
		"description": { "file": "./docs/registry/description.md" },
		"installation": { "file": "./docs/registry/installation.md" },
		"faq": { "file": "./docs/registry/faq.md" },
		"changelog": { "file": "./docs/registry/changelog.md" }
	},
	"release": {
		"artifacts": {
			"icon": { "file": "./icon.png" },
			"banner": { "file": "./images/banner.png" },
			// Dark counterpart lives at ./images/banner-dark.png. The schema accepts one banner.
			"screenshots": [
				{ "file": "./images/screenshot-1-reviews-on-post.png" },
				{ "file": "./images/screenshot-2-write.png" },
				{ "file": "./images/screenshot-3-waiting.png" },
				{ "file": "./images/screenshot-4-published.png" },
				{ "file": "./images/screenshot-5-settings.png" }
			]
		}
	},

	"capabilities": ["content:read", "schema:read", "email:send"],
	"allowedHosts": [],
	"storage": {
		"reviews": {
			"indexes": ["status", "entry", "member_id", "createdAt", "email", "pending_change", "stars", "has_text", "pending_email"]
		},
		"ratings": {
			"indexes": ["collection"]
		}
	},
	"admin": {
		"pages": [
			{
				"path": "/waiting",
				"label": "Waiting",
				"icon": "inbox",
				"group": "Reviews"
			},
			{
				"path": "/published",
				"label": "Published",
				"icon": "star",
				"group": "Reviews"
			},
			{
				"path": "/settings",
				"label": "Settings",
				"icon": "settings",
				"group": "Reviews"
			}
		],
		"widgets": [{ "id": "waiting", "title": "Reviews waiting", "size": "half" }]
	}
}
