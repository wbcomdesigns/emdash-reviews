---
// wb-reviews-kit: WB Reviews kit file. Running add-to-site.sh again replaces it.
/**
 * Reviews and the review form for one entry. Drop it into any page:
 *   <Reviews collection="posts" id={post.data.id} />
 * The markup is the same for every visitor, so the page stays safe to cache.
 * Who can write is decided in the browser from the health route.
 */
import { getSiteSettings } from "emdash";
import "../styles/wbcom-base.css";
import "../styles/reviews.css";
import { reviews as S } from "../lib/reviews-strings";

interface Props {
	collection: string;
	id: string;
	heading?: string;
}

const { collection, id, heading = S.heading } = Astro.props;
// Unique per render: the same page can show this twice (the in-text block and the theme slot).
const uid = `wbr-${id}-${crypto.randomUUID().slice(0, 8)}`;
const zone = (await getSiteSettings())?.timezone || "";
---

<section class="wb" data-wbr data-collection={collection} data-id={id} data-zone={zone} aria-labelledby={`${uid}-h`}>
	<div class="wb-summary">
		<h2 id={`${uid}-h`}>{heading}</h2>
		<p class="wb-muted" data-wbr-summary aria-live="polite">{S.loading}</p>
	</div>

	<div class="wbr-bars" data-wbr-bars hidden></div>

	<div class="wbr-toolbar" data-wbr-sortbar hidden>
		<label class="wb-label" for={`${uid}-sort`}>{S.sort}</label>
		<select class="wb-input" id={`${uid}-sort`} data-wbr-sort>
			<option value="newest">{S.sortNewest}</option>
			<option value="highest">{S.sortHighest}</option>
			<option value="lowest">{S.sortLowest}</option>
		</select>
	</div>

	<div data-wbr-list></div>
	<button class="wb-btn wb-btn--quiet wbr-more" type="button" data-wbr-more hidden>{S.showMore}</button>

	<p class="wb-empty" data-wbr-signin hidden>
		<strong>{S.signInWrite}</strong>{" "}
		<a href="/_emdash/admin/login">{S.signInLink}</a>
	</p>
	<form class="wb-form" data-wbr-form novalidate>
		<h3>{S.writeHeading}</h3>
		<fieldset class="wb-field" style="border:0;margin:0;padding:0;">
			<legend class="wb-label">{S.rating}</legend>
			<div class="wbr-rate">
				{
					[5, 4, 3, 2, 1].map((n) => (
						<>
							<input type="radio" name="stars" id={`${uid}-s${n}`} value={n} required />
							<label for={`${uid}-s${n}`}>
								<span class="wbr-off" aria-hidden="true">☆</span>
								<span class="wbr-on" aria-hidden="true">★</span>
								<span class="wb-sr">{S.star(n)}</span>
							</label>
						</>
					))
				}
			</div>
		</fieldset>
		<div class="wb-field" data-wbr-guest hidden>
			<label class="wb-label" for={`${uid}-name`}>{S.name}</label>
			<input class="wb-input" id={`${uid}-name`} name="name" maxlength="80" autocomplete="name" />
		</div>
		<div class="wb-field" data-wbr-email hidden>
			<label class="wb-label" for={`${uid}-email`}>{S.email}</label>
			<input class="wb-input" id={`${uid}-email`} name="email" type="email" maxlength="200" autocomplete="email" />
			<p class="wb-muted">{S.emailHelp}</p>
		</div>
		<div class="wb-sr" aria-hidden="true">
			<label for={`${uid}-website`}>Website</label>
			<input id={`${uid}-website`} name="website" tabindex="-1" autocomplete="off" />
		</div>
		<div class="wb-field">
			<label class="wb-label" for={`${uid}-title`}>{S.headline} <span class="wb-muted">{S.optional}</span></label>
			<input class="wb-input" id={`${uid}-title`} name="title" maxlength="120" autocomplete="off" />
		</div>
		<div class="wb-field">
			<label class="wb-label" for={`${uid}-body`}>{S.body} <span class="wb-muted">{S.optional}</span></label>
			<textarea class="wb-input" id={`${uid}-body`} name="body" maxlength="1000" aria-describedby={`${uid}-help`}></textarea>
			<p class="wb-muted" id={`${uid}-help`} data-wbr-help>{S.bodyHelp}</p>
		</div>
		<div>
			<button class="wb-btn" type="submit">{S.submit}</button>
		</div>
		<p class="wb-status" data-wbr-status role="status" hidden></p>
	</form>
</section>

<script>
	import { api, esc, signInUrl, starText } from "../lib/wbcom-kit";
	import { phrase, reviews as S } from "../lib/reviews-strings";

	type Review = {
		author?: string;
		stars?: number;
		title?: string;
		body?: string;
		createdAt?: string;
		owner_reply?: string;
		owner_reply_at?: string;
	};
	type Result = { ok: boolean; status?: string; error?: { code?: string } };
	type Bars = Record<string, number>;

	function tell(box: HTMLElement, result: Result, success: string) {
		box.hidden = false;
		box.dataset.tone = result.ok ? "success" : "error";
		if (result.ok) box.textContent = success;
		else if (["SIGN_IN_REQUIRED", "MEMBERS_ONLY", "GUEST_UNAVAILABLE"].includes(result.error?.code ?? "")) {
			box.innerHTML = `${esc(S.signIn)} <a href="${esc(signInUrl())}">${esc(S.signInLink)}</a>`;
		} else box.textContent = phrase(result.error?.code);
	}

	function renderBars(node: HTMLElement, bars: Bars, count: number) {
		if (!count) {
			node.hidden = true;
			node.innerHTML = "";
			return;
		}
		node.hidden = false;
		node.innerHTML = [5, 4, 3, 2, 1]
			.map((n) => {
				const hits = Number(bars[String(n)] || 0);
				const width = count ? Math.round((hits / count) * 100) : 0;
				return `<div class="wbr-bar-row"><span>${esc(String(n))}</span><span class="wbr-bar" aria-hidden="true"><span style="width:${width}%"></span></span><span class="wb-sr">${esc(S.bar(n, hits))}</span><span>${esc(String(hits))}</span></div>`;
			})
			.join("");
	}

	function day(value?: string): string {
		const date = new Date(String(value || ""));
		if (Number.isNaN(date.getTime())) return "";
		const timeZone = document.querySelector<HTMLElement>("[data-zone]")?.dataset.zone || undefined;
		try {
			return date.toLocaleDateString(undefined, { day: "numeric", month: "short", year: "numeric", timeZone });
		} catch {
			return date.toLocaleDateString(undefined, { day: "numeric", month: "short", year: "numeric" });
		}
	}

	function renderList(root: HTMLElement, items: Review[], replace: boolean, count = 0) {
		const list = root.querySelector<HTMLElement>("[data-wbr-list]");
		if (!list) return;
		if (!items.length && replace) {
			if (count > 0) {
				list.innerHTML = `<div class="wb-empty"><p><strong>${esc(S.starsOnlyTitle)}</strong></p><p class="wb-muted">${esc(S.starsOnlyHint(count))}</p></div>`;
			} else {
				list.innerHTML = `<div class="wb-empty"><p><strong>${esc(S.emptyTitle)}</strong></p><p class="wb-muted">${esc(S.emptyHint)}</p></div>`;
			}
			return;
		}
		const html = items
			.map(
				(item) =>
					`<li class="wb-item"><p><span class="wbr-stars" aria-hidden="true">${starText(item.stars)}</span><span class="wb-sr">${esc(S.outOf5(Number(item.stars) || 0))}</span> <strong>${esc(item.author || S.member)}</strong> <span class="wb-muted">${esc(day(item.createdAt))}</span></p>${item.title ? `<h3>${esc(item.title)}</h3>` : ""}${item.body ? `<p>${esc(item.body)}</p>` : ""}${item.owner_reply ? `<blockquote class="wbr-reply"><p class="wb-muted">${esc(S.ownerReply)}${item.owner_reply_at ? ` · ${esc(day(item.owner_reply_at))}` : ""}</p><p>${esc(item.owner_reply)}</p></blockquote>` : ""}</li>`,
			)
			.join("");
		if (replace) list.innerHTML = `<ul class="wb-list">${html}</ul>`;
		else list.querySelector("ul")?.insertAdjacentHTML("beforeend", html);
	}

	// Pages are cached the same for everyone, so ask a member route once per page. A guest gets a
	// 401 here, shown in the browser console; that is expected and the page is fine. An engine older
	// than 0.2.1 has no "me" route, so fall back to "mine" there.
	const signedInCheck = document.querySelector("[data-wbr]")
		? api("reviews", "me").then(async (me) =>
				me.ok ? true : me.error?.code === "SIGN_IN_REQUIRED" ? false : Boolean((await api("reviews", "mine")).ok),
			)
		: Promise.resolve(false);

	document.querySelectorAll<HTMLElement>("[data-wbr]").forEach(async (root) => {
		const collection = root.dataset.collection ?? "";
		const id = root.dataset.id ?? "";
		const summary = root.querySelector<HTMLElement>("[data-wbr-summary]");
		const barsNode = root.querySelector<HTMLElement>("[data-wbr-bars]");
		const more = root.querySelector<HTMLButtonElement>("[data-wbr-more]");
		const sort = root.querySelector<HTMLSelectElement>("[data-wbr-sort]");
		const sortbar = root.querySelector<HTMLElement>("[data-wbr-sortbar]");
		const guestBox = root.querySelector<HTMLElement>("[data-wbr-guest]");
		const emailBox = root.querySelector<HTMLElement>("[data-wbr-email]");
		const help = root.querySelector<HTMLElement>("[data-wbr-help]");
		let page = 1;
		let pages = 1;

		const health = await api("reviews", "health");
		const open = Array.isArray(health.collections) ? (health.collections as string[]) : [];
		if (health.ok && Array.isArray(health.collections) && !open.includes(collection)) {
			root.hidden = true;
			return;
		}
		// Guests can write only where the host passes EmDash the visitor's address. A 0.2.0 engine has no
		// guestWrites field; its "who" answer is then the whole story.
		const guestsWrite = health.guestWrites === undefined ? health.who !== "members" : health.guestWrites === true;
		const signedIn = await signedInCheck;
		const canWrite = signedIn || guestsWrite;
		const form = root.querySelector<HTMLFormElement>("[data-wbr-form]");
		const signInBox = root.querySelector<HTMLElement>("[data-wbr-signin]");
		const signInLink = signInBox?.querySelector("a");
		if (signInLink) signInLink.href = signInUrl();
		const signInText = signInBox?.querySelector("strong");
		if (signInText) signInText.textContent = health.hostAddress === false ? S.signInGuest : S.signInWrite;
		if (form) form.hidden = !canWrite;
		if (signInBox) signInBox.hidden = canWrite;
		// A signed-in member writes as their account: no name or email boxes.
		if (guestBox) guestBox.hidden = signedIn || !guestsWrite;
		if (emailBox) emailBox.hidden = signedIn || !guestsWrite || health.askEmail !== true;
		if (help) help.textContent = guestsWrite || signedIn ? S.bodyHelp : S.bodyHelpMembers;

		const load = async (nextPage = 1, append = false) => {
			const where = `collection=${encodeURIComponent(collection)}&id=${encodeURIComponent(id)}&page=${nextPage}&sort=${encodeURIComponent(sort?.value || "newest")}`;
			const data = await api("reviews", `list?${where}`);
			if (!data.ok) {
				if (summary) summary.textContent = S.loadError;
				return;
			}
			const count = Number(data.count) || 0;
			if (summary) {
				summary.innerHTML = count
					? `<span class="wbr-stars" aria-hidden="true">${starText(data.average)}</span> ${esc(S.summary(Number(data.average).toFixed(1), count))}`
					: S.none;
			}
			if (barsNode) renderBars(barsNode, (data.bars ?? {}) as Bars, count);
			page = Number(data.page) || 1;
			pages = Number(data.pages) || 1;
			renderList(root, (data.items ?? []) as Review[], !append, count);
			if (sortbar) sortbar.hidden = (Number(data.total) || 0) < 2;
			if (more) more.hidden = page >= pages;
		};
		await load(1, false);

		sort?.addEventListener("change", () => {
			void load(1, false);
		});
		more?.addEventListener("click", () => {
			void load(page + 1, true);
		});

		const status = root.querySelector<HTMLElement>("[data-wbr-status]");
		form?.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!status) return;
			const fields = new FormData(form);
			const stars = Number(fields.get("stars"));
			if (!stars || stars < 1 || stars > 5) {
				tell(status, { ok: false, error: { code: "NEED_STARS" } }, "");
				return;
			}
			const payload = {
				collection,
				id,
				stars,
				title: String(fields.get("title") ?? ""),
				body: String(fields.get("body") ?? ""),
				name: String(fields.get("name") ?? ""),
				email: String(fields.get("email") ?? ""),
				website: String(fields.get("website") ?? ""),
			};
			const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
			button?.setAttribute("aria-busy", "true");
			const result = (await api("reviews", signedIn ? "write" : "write_guest", payload)) as Result;
			button?.removeAttribute("aria-busy");
			tell(status, result, result.status === "published" ? S.thanksLive : S.thanksPending);
			if (result.ok) {
				form.reset();
				await load(1, false);
			}
		});
	});
</script>
