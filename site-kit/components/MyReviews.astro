---
// wb-reviews-kit: WB Reviews kit file. Running add-to-site.sh again replaces it.
/**
 * The signed-in member's own reviews: <MyReviews />
 * Guests see a sign-in link. Nothing member-specific is in the HTML, so the page can be cached.
 */
import "../styles/wbcom-base.css";
import "../styles/reviews.css";
import { mine as S } from "../lib/reviews-strings";
---

<section class="wb" data-wbr-mine aria-labelledby="wbr-mine-h">
	<h2 id="wbr-mine-h">{S.heading}</h2>
	<div data-wbr-mine-list><p class="wb-muted">{S.loading}</p></div>
	<div data-wbr-mine-actions hidden>
		<button class="wb-btn wb-btn--quiet" type="button" data-wbr-erase>{S.erase}</button>
	</div>
	<p class="wb-status" data-wbr-mine-status role="status" hidden></p>
</section>

<script>
	import { api, esc, signInUrl, starText } from "../lib/wbcom-kit";
	import { mine as S, phrase, reviews } from "../lib/reviews-strings";

	type Result = { ok: boolean; error?: { code?: string } };

	function tell(box: HTMLElement, result: Result, success: string) {
		box.hidden = false;
		box.dataset.tone = result.ok ? "success" : "error";
		if (result.ok) box.textContent = success;
		else if (result.error?.code === "SIGN_IN_REQUIRED") {
			box.innerHTML = `${esc(reviews.signIn)} <a href="${esc(signInUrl())}">${esc(reviews.signInLink)}</a>`;
		} else box.textContent = phrase(result.error?.code);
	}

	const STATUS: Record<string, string> = { pending: S.pending, published: S.published, rejected: S.rejected };

	document.querySelectorAll<HTMLElement>("[data-wbr-mine]").forEach(async (root) => {
		const list = root.querySelector<HTMLElement>("[data-wbr-mine-list]")!;
		const actions = root.querySelector<HTMLElement>("[data-wbr-mine-actions]")!;
		const status = root.querySelector<HTMLElement>("[data-wbr-mine-status]")!;

		const load = async () => {
			// A guest gets a 401 here (shown in the browser console). That is expected: it means "not signed in".
			const data = await api("reviews", "mine");
			if (!data.ok && data.error?.code === "SIGN_IN_REQUIRED") {
				// Not an error: a plain prompt in the same box as the empty state.
				actions.hidden = true;
				status.hidden = true;
				list.innerHTML = `<div class="wb-empty"><p><strong>${esc(S.signInTitle)}</strong></p><p><a href="${esc(signInUrl())}">${esc(reviews.signInLink)}</a></p></div>`;
				return;
			}
			if (!data.ok) {
				list.innerHTML = "";
				tell(status, data, "");
				return;
			}
			const items = (data.items ?? []) as Array<Record<string, unknown>>;
			actions.hidden = items.length === 0;
			list.innerHTML = items.length
				? `<ul class="wb-list">${items
						.map((item) => {
							const name = esc(item.entry_title || S.gone);
							const title = item.entry_url ? `<a href="${esc(item.entry_url)}">${name}</a>` : name;
							return `<li class="wb-item"><p><strong>${title}</strong> <span class="wb-muted">${esc(STATUS[String(item.status)] ?? item.status)}</span></p><p><span class="wbr-stars" aria-hidden="true">${starText(item.stars)}</span><span class="wb-sr">${esc(reviews.outOf5(Number(item.stars) || 0))}</span> ${esc(item.body)}</p></li>`;
						})
						.join("")}</ul>`
				: `<div class="wb-empty"><p><strong>${esc(S.emptyTitle)}</strong></p><p class="wb-muted">${esc(S.emptyHint)}</p></div>`;
		};
		await load();

		const erase = root.querySelector<HTMLButtonElement>("[data-wbr-erase]")!;
		erase.addEventListener("click", async () => {
			if (erase.dataset.armed !== "1") {
				erase.dataset.armed = "1";
				erase.textContent = S.eraseAgain;
				return;
			}
			erase.setAttribute("aria-busy", "true");
			// A member with many reviews waits a few seconds: say so until the list is back.
			status.hidden = false;
			status.dataset.tone = "";
			status.textContent = S.erasing;
			// A member with hundreds of reviews is erased over a few calls: the engine answers BUSY with reason MORE until none are left.
			let result = await api("reviews", "mine", undefined, "DELETE");
			for (let n = 0; n < 20 && !result.ok && result.error?.code === "BUSY" && (result.error as { reason?: string }).reason === "MORE"; n += 1) {
				result = await api("reviews", "mine", undefined, "DELETE");
			}
			erase.removeAttribute("aria-busy");
			erase.dataset.armed = "";
			erase.textContent = S.erase;
			list.innerHTML = `<p class="wb-muted">${esc(S.loading)}</p>`;
			await load();
			tell(status, result, S.erased);
		});
	});
</script>
