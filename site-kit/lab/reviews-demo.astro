---
/**
 * Lab only. Mounts every component so they can be walked in a browser.
 * A real site puts <Reviews> on its own post page instead.
 */
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import Reviews from "../components/Reviews.astro";

const { entries } = await getEmDashCollection("posts", { limit: 3 });
const first = entries[0];
---

<Base title="Reviews" description="Lab page for the Reviews and Ratings kit.">
	<div style="max-width: 42rem; margin-inline: auto; padding: 1.25rem 1rem 2rem;">
		{
			first ? (
				<Reviews collection="posts" id={first.data.id} heading="Reviews" />
			) : (
				<p>No posts in the lab yet.</p>
			)
		}
		<Reviews collection="pages" id="closed-check" heading="Closed" />
	</div>
</Base>
